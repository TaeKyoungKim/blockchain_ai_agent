# ==============================================================================
# Root .gitignore for Hybrid Real Estate Contract SaaS (Monorepo)
# ==============================================================================

# 1. Environment & Secrets (Crucial: Zero Hardcoded Secrets)
.env
.env.local
.env.*.local
*.pem
*.key

# 2. Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 3. Off-Chain Database & Local File Storage (PII & Generated PDFs)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/dev.db
backend/dev.db-wal
backend/dev.db-shm
backend/storage/
storage/

# 4. Geth Private Network Local Data (Chain State & Keystores)
.geth_dev_data/
blockchain/.geth_dev_data/

# 5. Blockchain / Hardhat Artifacts & Caches
blockchain/cache/
blockchain/artifacts/
typechain-types/

# 6. Python & uv Virtual Environments
.venv/
*/.venv/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# 7. Frontend Client Build Outputs (Vite / React)
client/dist/
client/dist-ssr/

# 8. OS & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
